{
  "name": "agent-mailhook",
  "version": "1.0.1",
  "description": "A configurable, stateless Cloudflare Email Worker template for authenticated email-to-webhook delivery.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jc0d35/agent-mailhook.git"
  },
  "bugs": {
    "url": "https://github.com/jc0d35/agent-mailhook/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm test && npm run dry-run -- --env development --outdir dist && node --test runtime.test.mjs",
    "test": "node --test index.test.mjs receiver.test.mjs",
    "receiver": "node examples/receiver.mjs",
    "dev": "wrangler dev --ip 127.0.0.1",
    "dry-run": "wrangler deploy --dry-run",
    "replay": "node replay.mjs"
  },
  "dependencies": {
    "postal-mime": "4.1.4"
  },
  "devDependencies": {
    "miniflare": "5.20261019.2-beta",
    "wrangler": "4.152.0"
  }
}
